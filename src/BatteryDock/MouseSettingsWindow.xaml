<Window x:Class="BatteryDock.MouseSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="鼠标设置"
        Width="560" Height="660" MinWidth="480" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource WindowBackgroundOpaqueBrush}"
        TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <Window.Resources>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource GlassInputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Ellipse Width="420" Height="420" Fill="{DynamicResource AmbientBlueBrush}"
                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-170,-190,0,0"
                 IsHitTestVisible="False" />
        <Ellipse Width="420" Height="380" Fill="{DynamicResource AmbientVioletBrush}"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-170,-190"
                 IsHitTestVisible="False" />
        <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Content="← 返回电量" Style="{StaticResource SoftButtonStyle}"
                    Focusable="False" Click="BackButton_Click"
                    Margin="0,0,14,0" VerticalAlignment="Center" />
            <Border Width="38" Height="38" CornerRadius="11"
                    Background="{DynamicResource AccentGradientBrush}">
                <TextBlock Text="&#xE962;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="鼠标设置" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="DeviceNameText" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,18,0,14"
                Style="{StaticResource GlassSectionStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="当前 DPI" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock x:Name="CurrentDpiText" Text="—" FontSize="30" FontWeight="SemiBold"
                               Margin="0,2,0,0" />
                    <TextBlock x:Name="CurrentXyText" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock x:Name="BackendText" Grid.Column="1" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Top" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <StackPanel x:Name="ControlsPanel" Grid.Row="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="调整 DPI" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="DpiBox" Width="86" TextAlignment="Right"
                             KeyDown="DpiBox_KeyDown" LostFocus="DpiBox_LostFocus" />
                    <TextBlock Text="DPI" FontSize="12" Margin="7,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Slider x:Name="DpiSlider" Margin="0,12,0,0"
                    Style="{StaticResource GlassSliderStyle}"
                    Minimum="100" Maximum="35000" TickFrequency="50" Value="1600"
                    IsSnapToTickEnabled="True"
                    ValueChanged="DpiSlider_ValueChanged" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RangeText" FontSize="11.5"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="RefreshButton" Content="刷新" Style="{StaticResource SoftButtonStyle}"
                            Click="RefreshButton_Click" Margin="0,0,8,0" />
                    <Button x:Name="ApplyButton" Content="应用 DPI" Style="{StaticResource SoftButtonStyle}"
                            Click="ApplyButton_Click" />
                </StackPanel>
            </Grid>

            <TextBlock Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       Text="DPI 通过设备 HID 命令写入当前档位，立即生效；当前版本不写入板载配置，重启或切换配置档后可能恢复原值。" />

            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,16,0,14" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="回报率" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock x:Name="PollingCurrentText" FontSize="11.5" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="正在读取…" />
                </StackPanel>
                <Button x:Name="PollingApplyButton" Grid.Column="1" Content="应用回报率"
                        Style="{StaticResource SoftButtonStyle}" Click="PollingApplyButton_Click"
                        VerticalAlignment="Center" />
            </Grid>

            <ListBox x:Name="PollingList" Style="{StaticResource SegmentListBoxStyle}"
                     Margin="0,9,0,0" IsEnabled="False" />

            <TextBlock Margin="0,9,0,0" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       Text="回报率上限取决于鼠标和接收器。普通 1K 接收器通常只支持到 1000 Hz。" />
        </StackPanel>

        <Border Grid.Row="3" Margin="0,18,0,0"
                Style="{StaticResource GlassSectionStyle}">
            <StackPanel>
                <TextBlock Text="侧键映射" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Margin="0,5,0,0" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="侧键映射需要逐型号的按键表和写入协议，当前版本暂未开放。" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="5" Margin="0,16,0,0"
                   FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="正在读取设备 DPI…" />
        </Grid>
    </Grid>
</Window>
