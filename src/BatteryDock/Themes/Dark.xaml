<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Liquid Glass · Dark
         Deep translucent shell, ambient light field, non-uniform
         specular edges. Keep text contrast above material fidelity.
         ============================================================ -->

    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F0141A26" Offset="0" />
        <GradientStop Color="#EE182033" Offset="0.52" />
        <GradientStop Color="#F00D121C" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WindowBackgroundOpaqueBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF141A26" Offset="0" />
        <GradientStop Color="#FF182033" Offset="0.52" />
        <GradientStop Color="#FF0D121C" Offset="1" />
    </LinearGradientBrush>

    <!-- 135° cold-silver rim: bright at top-left, almost gone at
         mid-edge, then a restrained counter-light at bottom-right. -->
    <LinearGradientBrush x:Key="WindowBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C4FFFFFF" Offset="0" />
        <GradientStop Color="#2EFFFFFF" Offset="0.3" />
        <GradientStop Color="#12FFFFFF" Offset="0.68" />
        <GradientStop Color="#66FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WindowEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C4FFFFFF" Offset="0" />
        <GradientStop Color="#2EFFFFFF" Offset="0.3" />
        <GradientStop Color="#12FFFFFF" Offset="0.68" />
        <GradientStop Color="#66FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WindowSheenBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#24FFFFFF" Offset="0" />
        <GradientStop Color="#0AFFFFFF" Offset="0.38" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- The light field is what the glass has to bend. Soft radial
         blobs, not neon gradients. -->
    <RadialGradientBrush x:Key="AmbientBlueBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#556D9BFF" Offset="0" />
        <GradientStop Color="#006D9BFF" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AmbientVioletBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#44A78BFA" Offset="0" />
        <GradientStop Color="#00A78BFA" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AmbientCyanBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#345EE7FF" Offset="0" />
        <GradientStop Color="#005EE7FF" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#18FFFFFF" Offset="0" />
        <GradientStop Color="#08FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#28FFFFFF" Offset="0" />
        <GradientStop Color="#10FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceStrongBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22FFFFFF" Offset="0" />
        <GradientStop Color="#0CFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassCardBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#24FFFFFF" Offset="0" />
        <GradientStop Color="#0EFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassCardHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#32FFFFFF" Offset="0" />
        <GradientStop Color="#16FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSectionBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#16FFFFFF" Offset="0" />
        <GradientStop Color="#08FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassHeaderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#26FFFFFF" Offset="0" />
        <GradientStop Color="#0CFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassCardBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5AFFFFFF" Offset="0" />
        <GradientStop Color="#14FFFFFF" Offset="0.34" />
        <GradientStop Color="#0AFFFFFF" Offset="0.7" />
        <GradientStop Color="#36FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassInnerHighlightBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A0FFFFFF" Offset="0" />
        <GradientStop Color="#1CFFFFFF" Offset="0.42" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassButtonBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#28FFFFFF" Offset="0" />
        <GradientStop Color="#0EFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassButtonHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3CFFFFFF" Offset="0" />
        <GradientStop Color="#18FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSelectedBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4A8FB8FF" Offset="0" />
        <GradientStop Color="#2AA78BFA" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassInputBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#14FFFFFF" Offset="0" />
        <GradientStop Color="#08FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SegmentTrackBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#12FFFFFF" Offset="0" />
        <GradientStop Color="#06FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassTrackBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1CFFFFFF" Offset="0" />
        <GradientStop Color="#0CFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="IconTileBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#307B9CFF" Offset="0" />
        <GradientStop Color="#18A78BFA" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="EmptyIconBackgroundBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#407B9CFF" Offset="0" />
        <GradientStop Color="#0AFFFFFF" Offset="0.68" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="DividerBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#18FFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#24FFFFFF" Offset="0" />
        <GradientStop Color="#0EFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScrollThumbBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#52FFFFFF" Offset="0" />
        <GradientStop Color="#28FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TrackBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#30FFFFFF" />
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F7FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A8FFFFFF" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#78FFFFFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#82B1FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2678A2FF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#D5E4FF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#63D89B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFCB6B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF7B86" />
    <SolidColorBrush x:Key="MutedBatteryBrush" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="ShadowBrush" Color="#B3000000" />
    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#F2182030" />

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5B8CFF" Offset="0" />
        <GradientStop Color="#8A7DFF" Offset="0.55" />
        <GradientStop Color="#62D9FF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SuccessGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#7BE7AE" Offset="0" />
        <GradientStop Color="#2FB97D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WarningGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFD98A" Offset="0" />
        <GradientStop Color="#F0A22E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DangerGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF9AA5" Offset="0" />
        <GradientStop Color="#E84E63" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MutedGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#A6FFFFFF" Offset="0" />
        <GradientStop Color="#4DFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="ShellShadowEffect" BlurRadius="34" ShadowDepth="8"
                      Opacity="0.52" Color="#000000" />
    <DropShadowEffect x:Key="CardShadowEffect" BlurRadius="18" ShadowDepth="4"
                      Opacity="0.24" Color="#000000" />
</ResourceDictionary>
