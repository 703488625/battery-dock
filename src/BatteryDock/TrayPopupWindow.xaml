<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="BatteryDock.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BatteryDock.Controls"
        Title="电量坞"
        Width="404"
        SizeToContent="Height"
        MaxHeight="760"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <Grid Margin="18">
        <Border x:Name="Shell"
                CornerRadius="28"
                Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource WindowEdgeBrush}"
                BorderThickness="1"
                Effect="{DynamicResource ShellShadowEffect}">
            <controls:RoundedClipPanel CornerRadius="27">
                <Grid>
                    <!-- Ambient light field: the material has something to bend. -->
                    <Ellipse Width="340" Height="340" Fill="{DynamicResource AmbientBlueBrush}"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="-120,-150,0,0" IsHitTestVisible="False" />
                    <Ellipse Width="310" Height="310" Fill="{DynamicResource AmbientVioletBrush}"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,30,-130,0" IsHitTestVisible="False" />
                    <Ellipse Width="380" Height="300" Fill="{DynamicResource AmbientCyanBrush}"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-100,-140" IsHitTestVisible="False" />
                    <Border Background="{DynamicResource WindowSheenBrush}"
                            IsHitTestVisible="False" />
                    <Border CornerRadius="27" BorderThickness="1,1,0,0"
                            BorderBrush="{DynamicResource GlassInnerHighlightBrush}"
                            IsHitTestVisible="False" />

                    <Grid x:Name="RootContent" Opacity="0">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="SlideTransform" Y="7" />
                        </Grid.RenderTransform>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header floating glass island -->
                        <Border Grid.Row="0" Margin="13,12,13,8" Padding="9,7"
                                CornerRadius="18"
                                Background="{DynamicResource GlassHeaderBrush}"
                                BorderBrush="{DynamicResource GlassCardBorderBrush}"
                                BorderThickness="1">
                            <Grid Background="Transparent" Cursor="SizeAll"
                                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Width="34" Height="34">
                                    <Border Width="34" Height="34" CornerRadius="11"
                                            Background="{DynamicResource AccentGradientBrush}"
                                            Visibility="{Binding IsSettingsOpen, Converter={StaticResource InverseBoolToVisibility}}">
                                        <Grid>
                                            <Viewbox Width="20" Height="20">
                                                <Canvas Width="22" Height="22">
                                                    <Border Canvas.Left="1" Canvas.Top="5" Width="15" Height="10"
                                                            CornerRadius="2.5" BorderBrush="White" BorderThickness="1.6" />
                                                    <Border Canvas.Left="17.2" Canvas.Top="8" Width="2.4" Height="4"
                                                            CornerRadius="1" Background="White" />
                                                    <Border Canvas.Left="3.4" Canvas.Top="7.3" Width="8.8" Height="5.4"
                                                            CornerRadius="1.2" Background="White" />
                                                </Canvas>
                                            </Viewbox>
                                            <Border CornerRadius="11" BorderThickness="1,1,0,0"
                                                    BorderBrush="{DynamicResource GlassInnerHighlightBrush}"
                                                    IsHitTestVisible="False" />
                                        </Grid>
                                    </Border>

                                    <Button Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Style="{StaticResource IconButtonStyle}"
                                            Command="{Binding CloseSettingsCommand}"
                                            ToolTip="返回"
                                            Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="&#xE76B;" Style="{StaticResource GlyphTextStyle}" FontSize="14" />
                                    </Button>
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding HeaderTitle}" FontSize="15.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6"
                                                Padding="5,1" Margin="7,0,0,0" VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource GlassCardBorderBrush}" BorderThickness="1"
                                                Visibility="{Binding IsDemo, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="演示" FontSize="9" Foreground="{DynamicResource AccentTextBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding HeaderSubtitle}" FontSize="10.2" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30"
                                            Command="{Binding RefreshCommand}" ToolTip="立即刷新"
                                            Visibility="{Binding IsSettingsOpen, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock Text="&#xE72C;" RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform x:Name="RefreshRotate" />
                                            </TextBlock.RenderTransform>
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource GlyphTextStyle}">
                                                    <Setter Property="FontSize" Value="14" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="RefreshSpin">
                                                                    <Storyboard RepeatBehavior="Forever">
                                                                        <DoubleAnimation
                                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                            From="0" To="360" Duration="0:0:0.8" FillBehavior="Stop" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <StopStoryboard BeginStoryboardName="RefreshSpin" />
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>

                                    <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30"
                                            Command="{Binding OpenSettingsCommand}" ToolTip="设置"
                                            Visibility="{Binding IsSettingsOpen, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock Text="&#xE713;" Style="{StaticResource GlyphTextStyle}" FontSize="14" />
                                    </Button>

                                    <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30"
                                            Click="CloseButton_Click" ToolTip="关闭">
                                        <TextBlock Text="&#xE8BB;" Style="{StaticResource GlyphTextStyle}" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                <ProgressBar Grid.Row="1" Height="2" Margin="17,0" IsIndeterminate="True"
                             Foreground="{DynamicResource AccentBrush}" Background="Transparent"
                             BorderThickness="0" Opacity="0.9"
                             Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibility}}" />

                <!-- Main view -->
                <Grid Grid.Row="2"
                      Visibility="{Binding IsSettingsOpen, Converter={StaticResource InverseBoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="17,0,17,8" Padding="10,8" CornerRadius="9"
                            Background="{DynamicResource AccentSoftBrush}"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource GlyphTextStyle}" FontSize="13"
                                       Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="10.5" Margin="7,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,34,24,38"
                                    Visibility="{Binding ShowLoadingState, Converter={StaticResource BoolToVisibility}}">
                            <Border Width="58" Height="58" CornerRadius="19" HorizontalAlignment="Center"
                                    Background="{DynamicResource EmptyIconBackgroundBrush}"
                                    BorderBrush="{DynamicResource GlassCardBorderBrush}" BorderThickness="1"
                                    Effect="{DynamicResource CardShadowEffect}">
                                <Grid>
                                    <Border CornerRadius="19" BorderThickness="1,1,0,0"
                                            BorderBrush="{DynamicResource GlassInnerHighlightBrush}"
                                            IsHitTestVisible="False" />
                                    <TextBlock Text="&#xE702;" Style="{StaticResource GlyphTextStyle}" FontSize="24"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Grid>
                            </Border>
                            <TextBlock Text="正在搜索蓝牙设备…" FontSize="12" Margin="0,13,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" Margin="26,28,26,32"
                                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                            <Border Width="64" Height="64" CornerRadius="21" HorizontalAlignment="Center"
                                    Background="{DynamicResource EmptyIconBackgroundBrush}"
                                    BorderBrush="{DynamicResource GlassCardBorderBrush}" BorderThickness="1"
                                    Effect="{DynamicResource CardShadowEffect}">
                                <Grid>
                                    <Border CornerRadius="21" BorderThickness="1,1,0,0"
                                            BorderBrush="{DynamicResource GlassInnerHighlightBrush}"
                                            IsHitTestVisible="False" />
                                    <TextBlock Text="&#xE702;" Style="{StaticResource GlyphTextStyle}" FontSize="27"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding EmptyTitle}" FontSize="14" FontWeight="SemiBold"
                                       Margin="0,14,0,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding EmptyDescription}" FontSize="10.7" MaxWidth="270"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Content="{Binding EmptyActionText}" Command="{Binding EmptyActionCommand}"
                                    Style="{StaticResource SoftButtonStyle}" Margin="0,15,0,0"
                                    HorizontalAlignment="Center" />
                        </StackPanel>

                        <ScrollViewer MaxHeight="372" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,0"
                                      Visibility="{Binding ShowDeviceList, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding Devices}" Margin="14,2,12,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,0,6" Click="DeviceCard_Click">
                                            <Button.Style>
                                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource DeviceCardButtonStyle}">
                                                    <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Headset">
                                                            <Setter Property="Cursor" Value="Arrow" />
                                                            <Setter Property="ToolTip" Value="耳机暂不支持打开设置" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="42" Height="42" CornerRadius="13"
                                                        Background="{DynamicResource IconTileBrush}"
                                                        BorderBrush="{DynamicResource GlassCardBorderBrush}"
                                                        BorderThickness="1">
                                                    <Grid>
                                                        <Border CornerRadius="13" BorderThickness="1,1,0,0"
                                                                BorderBrush="{DynamicResource GlassInnerHighlightBrush}"
                                                                IsHitTestVisible="False" />
                                                        <TextBlock Text="{Binding KindGlyph}" FontSize="18">
                                                            <TextBlock.Style>
                                                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource GlyphTextStyle}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                            <Setter Property="Opacity" Value="0.55" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>

                                                <Grid Grid.Column="1" Margin="11,0,0,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" FontSize="13.2"
                                                                   FontWeight="SemiBold" Margin="0,0,10,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding PercentText}"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="{x:Type TextBlock}">
                                                                    <Setter Property="FontFamily"
                                                                            Value="Segoe UI Variable Display, Microsoft YaHei UI" />
                                                                    <Setter Property="FontSize" Value="18" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource TextTertiaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding BatteryTone}" Value="Good">
                                                                            <Setter Property="Foreground"
                                                                                    Value="{DynamicResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding BatteryTone}" Value="Warning">
                                                                            <Setter Property="Foreground"
                                                                                    Value="{DynamicResource WarningBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding BatteryTone}" Value="Danger">
                                                                            <Setter Property="Foreground"
                                                                                    Value="{DynamicResource DangerBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>

                                                    <Grid Grid.Row="1" Margin="0,3,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding StatusText}" FontSize="10.3"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" Margin="7,0,0,0" Padding="6,1"
                                                                CornerRadius="5" Background="{DynamicResource AccentSoftBrush}"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding HasChargingState, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="{Binding ChargingText}" FontSize="9.6"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource SuccessBrush}" />
                                                        </Border>
                                                    </Grid>

                                                    <controls:BatteryBar Grid.Row="2" Value="{Binding BatteryValue}"
                                                                         Height="5" Margin="0,8,0,0">
                                                        <controls:BatteryBar.Style>
                                                            <Style TargetType="{x:Type controls:BatteryBar}">
                                                                <Setter Property="TrackBrush"
                                                                        Value="{DynamicResource TrackBrush}" />
                                                                <Setter Property="FillBrush"
                                                                        Value="{DynamicResource SuccessGradientBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding BatteryTone}" Value="Warning">
                                                                        <Setter Property="FillBrush"
                                                                                Value="{DynamicResource WarningGradientBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding BatteryTone}" Value="Danger">
                                                                        <Setter Property="FillBrush"
                                                                                Value="{DynamicResource DangerGradientBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding BatteryTone}" Value="Muted">
                                                                        <Setter Property="FillBrush"
                                                                                Value="{DynamicResource MutedGradientBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </controls:BatteryBar.Style>
                                                    </controls:BatteryBar>
                                                </Grid>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Settings view -->
                <Grid Grid.Row="2"
                      Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer MaxHeight="470" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Margin="17,0,13,0">
                        <StackPanel Margin="0,2,4,6">
                            <TextBlock Text="外观" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource GlassSectionStyle}" Margin="0,0,0,11">
                                <StackPanel>
                                    <TextBlock Text="主题" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="跟随系统自动适配 Windows 深浅色；切换后液态玻璃的环境光场与高光同步变化。"
                                               Style="{StaticResource SettingDescriptionStyle}" />
                                    <ListBox ItemsSource="{Binding Settings.Themes}"
                                             SelectedIndex="{Binding Settings.ThemeIndex, Mode=TwoWay}"
                                             Style="{StaticResource SegmentListBoxStyle}" Margin="0,9,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="刷新" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource GlassSectionStyle}" Margin="0,0,0,11">
                                <StackPanel>
                                    <TextBlock Text="刷新频率" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="打开面板时立即刷新；面板关闭时自动降低后台刷新频率。"
                                               Style="{StaticResource SettingDescriptionStyle}" />
                                    <ListBox ItemsSource="{Binding Settings.Refreshes}"
                                             SelectedIndex="{Binding Settings.RefreshIndex, Mode=TwoWay}"
                                             Style="{StaticResource SegmentListBoxStyle}" Margin="0,9,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="提醒" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource GlassSectionStyle}" Margin="0,0,0,11">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="低电量提醒" Style="{StaticResource SettingTitleStyle}" />
                                            <TextBlock Text="电量过低时通过系统通知提醒一次。"
                                                       Style="{StaticResource SettingDescriptionStyle}" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                                      IsChecked="{Binding Settings.LowBatteryAlert, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </Grid>
                                    <ListBox ItemsSource="{Binding Settings.ThresholdsLabels}"
                                             SelectedIndex="{Binding Settings.ThresholdIndex, Mode=TwoWay}"
                                             Style="{StaticResource SegmentListBoxStyle}" Margin="0,10,0,0"
                                             IsEnabled="{Binding Settings.LowBatteryAlert}" />
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,11" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="免打扰时段" Style="{StaticResource SettingTitleStyle}" />
                                            <TextBlock Text="时段内不弹低电量通知，结束后会补发一次。"
                                                       Style="{StaticResource SettingDescriptionStyle}" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                                      IsChecked="{Binding Settings.QuietHoursEnabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0"
                                                IsEnabled="{Binding Settings.QuietHoursEnabled}">
                                        <TextBlock Text="从" FontSize="11.5" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBox Text="{Binding Settings.QuietStartText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource TimeTextBoxStyle}" Margin="6,0,12,0" />
                                        <TextBlock Text="到" FontSize="11.5" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBox Text="{Binding Settings.QuietEndText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource TimeTextBoxStyle}" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Settings.QuietHoursSummary}" FontSize="10"
                                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="显示" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource GlassSectionStyle}" Margin="0,0,0,11">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="显示已断开的设备" Style="{StaticResource SettingTitleStyle}" />
                                            <TextBlock Text="键鼠和手柄会自动保留上次电量；打开后耳机等其他设备也保留。"
                                                       Style="{StaticResource SettingDescriptionStyle}" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                                      IsChecked="{Binding Settings.ShowDisconnectedDevices, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,11" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="显示耳机等其他设备" Style="{StaticResource SettingTitleStyle}" />
                                            <TextBlock Text="除键盘、鼠标、手柄外，也显示有电量的蓝牙设备。"
                                                       Style="{StaticResource SettingDescriptionStyle}" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                                      IsChecked="{Binding Settings.ShowAllDevices, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="系统" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource GlassSectionStyle}" Margin="0,0,0,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="开机自动启动" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="登录 Windows 后在托盘静默运行。"
                                                   Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                                  IsChecked="{Binding Settings.StartWithWindows, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="12,0,0,0" />
                                </Grid>
                            </Border>

                            <TextBlock Text="{Binding Settings.VersionText}" FontSize="9.8"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,8,0,4" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Footer floating glass bar -->
                <Border Grid.Row="3" Margin="13,0,13,10" Padding="14,8,12,9"
                        CornerRadius="14"
                        Background="{DynamicResource GlassHeaderBrush}"
                        BorderBrush="{DynamicResource GlassCardBorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding FooterText}" FontSize="10.2"
                                   Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Content="退出" Command="{Binding ExitCommand}"
                                Style="{StaticResource LinkButtonStyle}" Margin="10,0,0,0" />
                    </Grid>
                </Border>
            </Grid>
                </Grid>
            </controls:RoundedClipPanel>
        </Border>
    </Grid>
</Window>
