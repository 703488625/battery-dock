<Window x:Class="BatteryDock.KeyboardTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="键盘按键测试"
        Width="1100" Height="560" MinWidth="820" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource WindowBackgroundOpaqueBrush}"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        Deactivated="Window_Deactivated"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="KeycapBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource GlassCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTested}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPressed}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="TextElement.Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Ellipse Width="420" Height="420" Fill="{DynamicResource AmbientBlueBrush}"
                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-160,-190,0,0"
                 IsHitTestVisible="False" />
        <Ellipse Width="460" Height="360" Fill="{DynamicResource AmbientVioletBrush}"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-180,-190"
                 IsHitTestVisible="False" />
        <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Content="← 返回电量" Style="{StaticResource SoftButtonStyle}"
                    Focusable="False" Click="BackButton_Click"
                    Margin="0,0,14,0" VerticalAlignment="Center" />
            <Border Width="38" Height="38" CornerRadius="11"
                    Background="{DynamicResource AccentGradientBrush}">
                <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="键盘按键测试" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="DeviceNameText" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,10"
                Style="{StaticResource GlassSectionStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SummaryText" FontSize="13" VerticalAlignment="Center" />
                <TextBlock x:Name="LastKeyText" Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto" Padding="0,0,0,8">
            <StackPanel x:Name="KeyboardRows" HorizontalAlignment="Center" />
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"
                       TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="逐键短按测试。部分系统保留键（Win、PrintScreen、Alt+Tab 等）可能被 Windows 拦截。" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="重置测试" Style="{StaticResource SoftButtonStyle}"
                        Focusable="False" Click="ResetButton_Click" Margin="0,0,8,0" />
                <Button Content="关闭" Style="{StaticResource SoftButtonStyle}"
                        Focusable="False" Click="CloseButton_Click" />
            </StackPanel>
        </Grid>
        </Grid>
    </Grid>
</Window>
